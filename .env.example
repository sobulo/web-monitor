# ActivityInfo bootstrap/persistence use these placeholders via environment or .env.
ACTIVITYINFO_API_TOKEN=replace_with_activityinfo_api_token
ACTIVITYINFO_DATABASE_ID=replace_with_activityinfo_database_id
GOOGLE_CLOUD_PROJECT=replace_with_google_cloud_project_id

# Exact URLs copied from ActivityInfo Publishing; never infer them from IDs.
ACTIVITYINFO_SINGLE_EMBED_URL=
ACTIVITYINFO_NOTEBOOK_PUBLIC_URL=
